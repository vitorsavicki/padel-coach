# Variaveis locais para `wrangler dev` (copie para .dev.vars).
# Chaves reais NAO vao para o git.
# Para producao, use: `wrangler secret put NOME`.

# Gemini gratis (sem cartao): https://aistudio.google.com/apikey
# IA_MODEL e so o nome do modelo, sem prefixo de provedor.
IA_API_KEY=AIza...sua-chave-gemini
# So o nome do modelo, sem "gemini/" na frente (isso gera 404).
IA_MODEL=gemini-2.5-flash
# Opcional - so mude se quiser outro endpoint compativel.
# IA_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Groq gratis (sem cartao): https://console.groq.com/keys
# GROQ_API_KEY=gsk_...

# Alternativas gratis (API compativel com OpenAI). Ative so as que tiver.
# OpenRouter: https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# Mistral: https://console.mistral.ai/api-keys (plano Experiment pede telefone)
# MISTRAL_API_KEY=...
# MISTRAL_MODEL=ministral-8b-2512
# GitHub Models: https://github.com/settings/tokens (PAT com models:read)
# GITHUB_MODELS_TOKEN=github_pat_...
# GITHUB_MODEL=openai/gpt-4o

# Perfil do jogador: agora e por conta, na pagina /perfil do site.
# Nao existe mais variavel global de perfil.

# Mercado Pago (opcional; sem isso /planos mostra "pagamento em breve")
MP_ACCESS_TOKEN=token-do-mercado-pago

# Reservado para assinatura de sessao, se precisar no futuro.
SESSION_SECRET=troque-por-uma-string-longa-aleatoria
